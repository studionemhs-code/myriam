{
  "name": "Nova Funcionalidade Liberada",
  "description": "Notifica todos os usu\u00e1rios quando uma funcionalidade \u00e9 ativada no app",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "FeatureFlag",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.visible == true and .trigger.old_data.visible != true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nova_funcionalidade_liberada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "broadcast": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "broadcastNotification",
            "args": {
              "category": "novidades",
              "title": "Nova funcionalidade: ${ .trigger.data.label }",
              "body": "A funcionalidade ${ .trigger.data.label } agora est\u00e1 dispon\u00edvel no app. Toque para saber mais.",
              "related_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar todos os usu\u00e1rios",
            "description": "Broadcast de nova funcionalidade liberada"
          }
        }
      }
    ]
  }
}