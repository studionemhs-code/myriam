{
  "name": "Lembretes Di\u00e1rios Marianos",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Gerar lembretes di\u00e1rios",
            "description": "Renova\u00e7\u00e3o, consagra\u00e7\u00e3o e prepara\u00e7\u00e3o"
          }
        }
      }
    ]
  },
  "description": "Verifica diariamente datas de renova\u00e7\u00e3o, consagra\u00e7\u00e3o e prepara\u00e7\u00e3o, criando notifica\u00e7\u00f5es para os usu\u00e1rios eleg\u00edveis",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}