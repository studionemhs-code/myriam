{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Notification"
    }
  },
  "name": "Webhook Notificacao Offline",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "webhook_notification_offline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "wait_read": {
          "wait": "PT30S",
          "then": "dispatch",
          "x-base44": {
            "title": "Aguardar leitura",
            "description": "30s para destinat\u00e1rio ler"
          }
        }
      },
      {
        "dispatch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchWebhooks",
            "args": {
              "trigger_type": "${ .trigger.data.category }",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Disparar webhooks",
            "description": "Verifica leitura e dispara"
          }
        }
      }
    ]
  },
  "description": "Quando uma notifica\u00e7\u00e3o \u00e9 criada, aguarda 30s e verifica se o destinat\u00e1rio leu. Se n\u00e3o leu, dispara webhooks configurados pelo admin para a categoria da notifica\u00e7\u00e3o."
}