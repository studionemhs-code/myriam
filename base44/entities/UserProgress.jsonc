{
  "properties": {
    "current_day": {
      "type": "integer",
      "default": 1,
      "minimum": 1
    },
    "completed_days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": []
    },
    "started_date": {
      "type": "string",
      "format": "date"
    },
    "last_access_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "concluida",
        "pausada"
      ],
      "default": "ativa"
    }
  },
  "required": [
    "current_day"
  ],
  "name": "UserProgress",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}