{
  "name": "CollectiveJourney",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativa",
        "pausada",
        "encerrada"
      ],
      "default": "ativa"
    },
    "journey_type": {
      "type": "string",
      "enum": [
        "consagracao",
        "renovacao"
      ],
      "default": "consagracao",
      "description": "Tipo da jornada: consagra\u00e7\u00e3o ou renova\u00e7\u00e3o"
    },
    "welcome_message": {
      "type": "string",
      "description": "Mensagem exibida ao iniciar a jornada"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Etapas gamificadas da jornada"
    },
    "content_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "participant_count": {
      "type": "integer",
      "default": 0,
      "description": "Contagem denormalizada de participantes"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}