{
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativa",
        "pausada",
        "encerrada"
      ],
      "default": "ativa"
    },
    "content_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "participant_count": {
      "type": "integer",
      "default": 0,
      "description": "Contagem denormalizada de participantes"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "name": "CollectiveJourney",
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}