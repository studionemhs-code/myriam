{
  "name": "PrayerGalleryImage",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "URL da imagem ou anima\u00e7\u00e3o de fundo do Modo Ora\u00e7\u00e3o"
    },
    "label": {
      "type": "string",
      "description": "Nome identificador do fundo (ex.: Nossa Senhora, Velas, Ter\u00e7o)"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na galeria"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o fundo aparece para os usu\u00e1rios no Modo Ora\u00e7\u00e3o"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}