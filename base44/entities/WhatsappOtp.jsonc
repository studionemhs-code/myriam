{
  "name": "WhatsappOtp",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio em processo de cadastro"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "N\u00famero de WhatsApp que receber\u00e1 o token"
    },
    "token_hash": {
      "type": "string",
      "description": "Hash SHA-256 do token + email (nunca armazenar o token em texto plano)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expira\u00e7\u00e3o do token"
    },
    "attempts_used": {
      "type": "integer",
      "default": 0,
      "description": "Tentativas de valida\u00e7\u00e3o j\u00e1 consumidas"
    },
    "resends_used": {
      "type": "integer",
      "default": 0,
      "description": "Reenvios do token j\u00e1 consumidos"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o token foi validado com sucesso"
    }
  },
  "required": [
    "email",
    "whatsapp_number",
    "token_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}