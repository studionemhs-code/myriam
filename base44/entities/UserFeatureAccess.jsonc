{
  "name": "UserFeatureAccess",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que recebeu a concess\u00e3o"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio (denormalizado para exibi\u00e7\u00e3o no admin)"
    },
    "feature": {
      "type": "string",
      "description": "Identificador da funcionalidade/p\u00e1gina (ex: acamf, myriam, associacao)"
    },
    "granted": {
      "type": "boolean",
      "default": true,
      "description": "Se true, o usu\u00e1rio tem acesso liberado \u00e0 funcionalidade mesmo se ela estiver oculta globalmente"
    }
  },
  "required": [
    "user_id",
    "feature"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}