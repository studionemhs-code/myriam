{
  "name": "PreparationDay",
  "type": "object",
  "properties": {
    "day_number": {
      "type": "integer",
      "description": "N\u00famero do dia (1 a 33)",
      "minimum": 1,
      "maximum": 33
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do dia"
    },
    "description": {
      "type": "string",
      "description": "Breve descri\u00e7\u00e3o do tema do dia"
    },
    "phase": {
      "type": "string",
      "description": "Nome da fase (referencia uma PreparationPhase)"
    },
    "gender": {
      "type": "string",
      "description": "Sexo alvo do conte\u00fado. O usu\u00e1rio s\u00f3 v\u00ea conte\u00fados do seu pr\u00f3prio sexo.",
      "enum": [
        "masculino",
        "feminino"
      ]
    },
    "text": {
      "type": "string",
      "description": "Conte\u00fado textual do dia (formato rico/markdown)"
    },
    "prayer": {
      "type": "string",
      "description": "Ora\u00e7\u00e3o do dia"
    },
    "practice": {
      "type": "string",
      "description": "Pr\u00e1tica espiritual sugerida"
    },
    "reflection_prompt": {
      "type": "string",
      "description": "Pergunta-guia para reflex\u00e3o pessoal"
    },
    "audio_url": {
      "type": "string",
      "format": "uri"
    },
    "video_url": {
      "type": "string",
      "format": "uri"
    },
    "youtube_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "pdf_url": {
      "type": "string",
      "format": "uri"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "related_content_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "day_number",
    "title",
    "gender"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}