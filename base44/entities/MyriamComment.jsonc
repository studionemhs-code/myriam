{
  "name": "MyriamComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "ID do coment\u00e1rio pai (para respostas aninhadas)"
    },
    "author_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio autor"
    },
    "text": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_photo": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "post_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}