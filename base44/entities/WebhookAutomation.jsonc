{
  "name": "WebhookAutomation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome identificador do webhook"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL de destino do webhook"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "message_template": {
      "type": "string",
      "default": "Voc\u00ea recebeu uma nova mensagem de {remetente_nome}: {mensagem_texto}"
    },
    "trigger_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chat",
          "caminho",
          "renovacao",
          "myriam",
          "intencoes",
          "acamf",
          "jornadas",
          "novidades",
          "associacao",
          "orcamento"
        ]
      },
      "default": [
        "chat"
      ]
    },
    "orcamento_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "novo",
          "em_andamento",
          "enviado",
          "saiu_para_entrega",
          "atendido",
          "fechado",
          "cancelado"
        ]
      },
      "default": []
    },
    "wait_seconds": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 300
    },
    "custom_headers": {
      "type": "object",
      "default": {}
    },
    "test_phone": {
      "type": "string",
      "description": "N\u00famero usado para testar o envio do webhook"
    }
  },
  "required": [
    "name",
    "url",
    "message_template"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}