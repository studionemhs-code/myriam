{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "knowledge_content": {
      "type": "string"
    },
    "knowledge_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "knowledge_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "site",
              "youtube",
              "instagram",
              "audio"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          },
          "extracted_content": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "ready",
              "error"
            ],
            "default": "pending"
          },
          "error_message": {
            "type": "string"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "model": {
      "type": "string",
      "enum": [
        "automatic",
        "gpt_5_mini",
        "gpt_5_4",
        "gpt_5_6_sol",
        "gpt_5_6_luna",
        "gpt-4o",
        "gpt-4o-mini",
        "gpt-3.5-turbo"
      ],
      "default": "automatic"
    },
    "openai_api_key": {
      "type": "string"
    },
    "welcome_message": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "default": 0.7
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "admin_only": {
      "type": "boolean",
      "default": false
    },
    "icon_url": {
      "type": "string",
      "format": "uri"
    },
    "is_floating_main": {
      "type": "boolean",
      "default": false
    },
    "tools_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "calculator",
          "web_search",
          "system_query",
          "get_preparation_day",
          "list_acamf_content",
          "list_prayers",
          "get_active_journeys",
          "generate_pdf",
          "generate_image"
        ]
      },
      "default": []
    },
    "reasoning_enabled": {
      "type": "boolean",
      "default": false
    },
    "architect_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "message_delay_ms": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 5000
    },
    "chat_retention_days": {
      "type": "integer",
      "default": 7,
      "minimum": 7
    },
    "voice_enabled": {
      "type": "boolean",
      "default": true
    },
    "files_enabled": {
      "type": "boolean",
      "default": true
    },
    "default_voice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark",
        "marin_br"
      ],
      "default": "river"
    },
    "voice_language": {
      "type": "string",
      "enum": [
        "pt-BR",
        "pt-PT",
        "en",
        "es",
        "auto"
      ],
      "default": "pt-BR"
    },
    "max_pdfs_per_month": {
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "description": "Limite mensal de PDFs que usuarios comuns podem gerar por este agente. Admins nao tem limite."
    },
    "max_images_per_month": {
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "description": "Limite mensal de imagens que usuarios comuns podem gerar por este agente. Admins nao tem limite."
    }
  },
  "required": [
    "name",
    "instructions",
    "model"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}