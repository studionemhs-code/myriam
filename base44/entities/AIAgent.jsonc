{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do agente"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta exibida aos usu\u00e1rios"
    },
    "instructions": {
      "type": "string",
      "description": "System prompt / instru\u00e7\u00f5es de comportamento do agente"
    },
    "knowledge_content": {
      "type": "string",
      "description": "Texto extra\u00eddo das fontes de conhecimento"
    },
    "knowledge_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "model": {
      "type": "string",
      "enum": [
        "gpt-4o-mini",
        "gpt-4o",
        "gpt-3.5-turbo"
      ],
      "default": "gpt-4o-mini"
    },
    "openai_api_key": {
      "type": "string",
      "description": "Chave API OpenAI fornecida pelo admin. Se vazio, usa a chave padr\u00e3o do backend."
    },
    "welcome_message": {
      "type": "string",
      "description": "Mensagem exibida ao iniciar conversa"
    },
    "temperature": {
      "type": "number",
      "default": 0.7,
      "description": "Criatividade das respostas (0-1)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "icon_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do logo/\u00edcone do agente exibido no bot\u00e3o flutuante. Se vazio, usa o \u00edcone padr\u00e3o."
    },
    "is_floating_main": {
      "type": "boolean",
      "default": false,
      "description": "Se true, este agente \u00e9 o principal do bot\u00e3o flutuante (apenas um agente por vez pode ter esta flag)"
    },
    "tools_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "calculator",
          "web_search",
          "system_query",
          "get_preparation_day",
          "list_acamf_content",
          "list_prayers",
          "get_active_journeys"
        ]
      },
      "default": [],
      "description": "Ferramentas ativas no agente: calculadora, pesquisa na internet, copiloto do sistema, exerc\u00edcios da caminhada, conte\u00fados ACAMF, ora\u00e7\u00f5es, jornadas"
    },
    "reasoning_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Ativa modo de racioc\u00ednio profundo \u2014 usa modelo mais capaz e instru\u00e7\u00e3o para pensar passo a passo"
    },
    "message_delay_ms": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 5000,
      "description": "Atraso em milissegundos entre partes da resposta (quebra de mensagens). 0 = resposta instant\u00e2nea."
    }
  },
  "required": [
    "name",
    "instructions",
    "model"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}