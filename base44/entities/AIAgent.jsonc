{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "knowledge_content": {
      "type": "string"
    },
    "knowledge_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "model": {
      "type": "string",
      "enum": [
        "automatic",
        "gpt_5_mini",
        "gpt_5_4",
        "gpt_5_6_sol",
        "gpt_5_6_luna",
        "gpt-4o",
        "gpt-4o-mini"
      ],
      "default": "automatic"
    },
    "openai_api_key": {
      "type": "string"
    },
    "welcome_message": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "default": 0.7
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "icon_url": {
      "type": "string",
      "format": "uri"
    },
    "is_floating_main": {
      "type": "boolean",
      "default": false
    },
    "tools_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "calculator",
          "web_search",
          "system_query",
          "get_preparation_day",
          "list_acamf_content",
          "list_prayers",
          "get_active_journeys"
        ]
      },
      "default": []
    },
    "reasoning_enabled": {
      "type": "boolean",
      "default": false
    },
    "architect_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "message_delay_ms": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 5000
    },
    "voice_enabled": {
      "type": "boolean",
      "default": true
    },
    "files_enabled": {
      "type": "boolean",
      "default": true
    },
    "default_voice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "default": "river"
    }
  },
  "required": [
    "name",
    "instructions",
    "model"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}