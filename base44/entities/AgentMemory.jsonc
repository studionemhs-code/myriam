{
  "name": "AgentMemory",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID do agente ao qual a mem\u00f3ria pertence"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio cujas mem\u00f3rias s\u00e3o armazenadas"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string",
            "description": "Fato lembrado sobre o usu\u00e1rio"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Lista de fatos extra\u00eddos da conversa e persistidos para mem\u00f3ria de longo prazo"
    }
  },
  "required": [
    "agent_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}