{
  "name": "Prayer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Texto rico da ora\u00e7\u00e3o (HTML do ReactQuill)"
    },
    "audio_url": {
      "type": "string",
      "format": "uri"
    },
    "cover_url": {
      "type": "string",
      "format": "uri"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}