{
  "name": "StoreSettings",
  "type": "object",
  "properties": {
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp da loja (DDI + DDD + n\u00famero, s\u00f3 d\u00edgitos)"
    },
    "brand_name": {
      "type": "string",
      "default": "Theotokos"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_subtitle": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#663399"
    },
    "accent_color": {
      "type": "string",
      "default": "#9b59b6"
    },
    "logo_url": {
      "type": "string",
      "format": "uri"
    },
    "message_template": {
      "type": "string",
      "description": "Template da mensagem WhatsApp. Vari\u00e1veis: {{name}}, {{whatsapp}}, {{address}}, {{items}}, {{notes}}"
    },
    "step_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Dados",
        "Cadeiazinha",
        "Medalh\u00f5es",
        "Escapul\u00e1rios",
        "Revis\u00e3o"
      ]
    }
  },
  "required": [
    "whatsapp",
    "brand_name",
    "message_template"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}