{
  "name": "MyriamPost",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "Texto da publica\u00e7\u00e3o"
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "video_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do v\u00eddeo da publica\u00e7\u00e3o"
    },
    "document_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do documento anexo (PDF, etc.)"
    },
    "author_name": {
      "type": "string"
    },
    "author_photo": {
      "type": "string",
      "format": "uri"
    },
    "author_status": {
      "type": "string",
      "enum": [
        "interessado",
        "preparacao",
        "consagrado"
      ],
      "default": "interessado"
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "prayer_count": {
      "type": "integer",
      "default": 0
    },
    "comment_count": {
      "type": "integer",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_testimonial": {
      "type": "boolean",
      "default": false,
      "description": "Se true, \u00e9 um testemunho de consagra\u00e7\u00e3o exibido no Mural"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o testemunho est\u00e1 fixado em destaque no Mural (apenas admin)"
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}