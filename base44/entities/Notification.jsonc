{
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Destinat\u00e1rio da notifica\u00e7\u00e3o (id do usu\u00e1rio)"
    },
    "category": {
      "type": "string",
      "enum": [
        "caminho",
        "renovacao",
        "myriam",
        "intencoes",
        "acamf",
        "jornadas",
        "novidades",
        "associacao",
        "assistente_ia"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "format": "uri",
      "description": "URL de v\u00eddeo enviado pelo admin para exibir ao clicar na notifica\u00e7\u00e3o"
    },
    "youtube_id": {
      "type": "string",
      "description": "ID de v\u00eddeo do YouTube para exibir ao clicar na notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "user_id",
    "category",
    "title"
  ],
  "name": "Notification",
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}