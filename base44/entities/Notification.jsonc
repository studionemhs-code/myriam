{
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Destinat\u00e1rio da notifica\u00e7\u00e3o (id do usu\u00e1rio)"
    },
    "category": {
      "type": "string",
      "enum": [
        "caminho",
        "renovacao",
        "myriam",
        "intencoes",
        "acamf",
        "jornadas"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "category",
    "title"
  ],
  "name": "Notification",
  "type": "object",
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}