{
  "name": "PersonalizationSettings",
  "type": "object",
  "properties": {
    "level_interessado_name": {
      "type": "string",
      "description": "Nome do n\u00edvel espiritual exibido no onboarding e perfil para usu\u00e1rios interessados. Vazio = usa o padr\u00e3o 'Quero Conhecer'."
    },
    "level_interessado_desc": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do n\u00edvel exibida no onboarding e perfil para interessados. Vazio = usa o padr\u00e3o."
    },
    "level_preparacao_name": {
      "type": "string",
      "description": "Nome do n\u00edvel para usu\u00e1rios em prepara\u00e7\u00e3o. Vazio = usa o padr\u00e3o 'Quero Me Preparar'."
    },
    "level_preparacao_desc": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do n\u00edvel para usu\u00e1rios em prepara\u00e7\u00e3o. Vazio = usa o padr\u00e3o."
    },
    "level_consagrado_name": {
      "type": "string",
      "description": "Nome do n\u00edvel para usu\u00e1rios consagrados. Vazio = usa o padr\u00e3o 'J\u00e1 Sou Consagrado'."
    },
    "level_consagrado_desc": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do n\u00edvel para usu\u00e1rios consagrados. Vazio = usa o padr\u00e3o."
    },
    "splash_video_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do v\u00eddeo de abertura exibido ao abrir o app (mobile). Vazio = usa o v\u00eddeo padr\u00e3o."
    },
    "login_bg_desktop": {
      "type": "string",
      "format": "uri",
      "description": "URL da imagem de fundo da tela de login (desktop). Vazio = usa a imagem padr\u00e3o."
    },
    "login_bg_mobile": {
      "type": "string",
      "format": "uri",
      "description": "URL da imagem de fundo da tela de login (mobile). Vazio = usa a imagem padr\u00e3o."
    },
    "favicon_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do favicon exibido na aba do navegador. Vazio = usa o favicon padr\u00e3o."
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}