{
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "pdf",
        "ebook",
        "document",
        "youtube"
      ],
      "default": "image"
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "thumbnail_url": {
      "type": "string",
      "format": "uri"
    },
    "size": {
      "type": "integer",
      "description": "Tamanho em bytes"
    },
    "youtube_id": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "arquivado"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "name",
    "type",
    "file_url"
  ],
  "name": "MediaAsset",
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}