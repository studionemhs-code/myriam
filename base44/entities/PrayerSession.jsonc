{
  "name": "PrayerSession",
  "type": "object",
  "properties": {
    "prayer_id": {
      "type": "string",
      "description": "ID da ora\u00e7\u00e3o conclu\u00edda (ou refer\u00eancia sint\u00e9tica para dias do Caminho)"
    },
    "prayer_title": {
      "type": "string",
      "description": "T\u00edtulo da ora\u00e7\u00e3o (denormalizado para o hist\u00f3rico)"
    },
    "source": {
      "type": "string",
      "enum": [
        "oracoes",
        "caminho"
      ],
      "default": "oracoes",
      "description": "Origem da sess\u00e3o imersiva"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que a ora\u00e7\u00e3o foi marcada como conclu\u00edda"
    },
    "duration_seconds": {
      "type": "integer",
      "default": 0,
      "description": "Dura\u00e7\u00e3o da sess\u00e3o imersiva em segundos"
    }
  },
  "required": [
    "prayer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}