{
  "properties": {
    "role": {
      "type": "string",
      "description": "Papel do usu\u00e1rio no ecosistema Theotokos",
      "enum": [
        "admin",
        "moderator",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio (sobrep\u00f5e full_name quando preenchido)"
    },
    "bio": {
      "type": "string",
      "description": "Breve biografia do usu\u00e1rio"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "Foto de perfil"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do usu\u00e1rio para notifica\u00e7\u00f5es via WhatsApp (DDI+DDD+n\u00famero, s\u00f3 d\u00edgitos)"
    },
    "gender": {
      "type": "string",
      "description": "Sexo do usu\u00e1rio para personaliza\u00e7\u00e3o do conte\u00fado da caminhada",
      "enum": [
        "masculino",
        "feminino"
      ]
    },
    "status": {
      "type": "string",
      "description": "Est\u00e1gio da caminhada do usu\u00e1rio",
      "enum": [
        "interessado",
        "preparacao",
        "consagrado"
      ],
      "default": "interessado"
    },
    "exclusive_access": {
      "type": "boolean",
      "default": false,
      "description": "Concede acesso a todas as funcionalidades exclusivas (ACAMF, etc.), independente do n\u00edvel espiritual"
    },
    "consecration_date": {
      "type": "string",
      "format": "date",
      "description": "PRIMEIRA data da Total Consagra\u00e7\u00e3o \u2014 imut\u00e1vel ap\u00f3s o registro (apenas uma corre\u00e7\u00e3o \u00fanica na janela de 7 dias)"
    },
    "consecration_date_edited": {
      "type": "boolean",
      "default": false,
      "description": "Indica que a corre\u00e7\u00e3o \u00fanica da data de consagra\u00e7\u00e3o j\u00e1 foi utilizada"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio concluiu o onboarding inicial"
    },
    "preparation_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da prepara\u00e7\u00e3o de 33 dias"
    },
    "target_consecration_date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para a consagra\u00e7\u00e3o"
    },
    "last_renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima renova\u00e7\u00e3o anual registrada"
    },
    "renewals": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "default": [],
      "description": "Hist\u00f3rico de consagra\u00e7\u00e3o/renova\u00e7\u00f5es \u2014 o \u00edndice 0 \u00e9 sempre a consagra\u00e7\u00e3o original"
    },
    "notification_prefs": {
      "type": "object",
      "description": "Prefer\u00eancias de notifica\u00e7\u00e3o por categoria (true = ativa)",
      "properties": {
        "caminho": {
          "type": "boolean"
        },
        "renovacao": {
          "type": "boolean"
        },
        "myriam": {
          "type": "boolean"
        },
        "intencoes": {
          "type": "boolean"
        },
        "acamf": {
          "type": "boolean"
        },
        "jornadas": {
          "type": "boolean"
        }
      },
      "default": {}
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}