{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Papel do usu\u00e1rio no ecosistema Theotokos",
      "enum": [
        "admin",
        "moderator",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio (sobrep\u00f5e full_name quando preenchido)"
    },
    "bio": {
      "type": "string",
      "description": "Breve biografia do usu\u00e1rio"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "Foto de perfil"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do usu\u00e1rio para notifica\u00e7\u00f5es via WhatsApp (DDI+DDD+n\u00famero, s\u00f3 d\u00edgitos)"
    },
    "gender": {
      "type": "string",
      "description": "Sexo do usu\u00e1rio para personaliza\u00e7\u00e3o do conte\u00fado da caminhada",
      "enum": [
        "masculino",
        "feminino"
      ]
    },
    "status": {
      "type": "string",
      "description": "Est\u00e1gio da caminhada do usu\u00e1rio",
      "enum": [
        "interessado",
        "preparacao",
        "consagrado",
        "usuario_escolhe"
      ],
      "default": "interessado"
    },
    "exclusive_access": {
      "type": "boolean",
      "default": false,
      "description": "Concede acesso a todas as funcionalidades exclusivas"
    },
    "consecration_date": {
      "type": "string",
      "format": "date"
    },
    "consecration_date_edited": {
      "type": "boolean",
      "default": false
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "preparation_start_date": {
      "type": "string",
      "format": "date"
    },
    "target_consecration_date": {
      "type": "string",
      "format": "date"
    },
    "last_renewal_date": {
      "type": "string",
      "format": "date"
    },
    "renewals": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "default": []
    },
    "notification_prefs": {
      "type": "object",
      "properties": {
        "caminho": {
          "type": "boolean"
        },
        "renovacao": {
          "type": "boolean"
        },
        "myriam": {
          "type": "boolean"
        },
        "intencoes": {
          "type": "boolean"
        },
        "acamf": {
          "type": "boolean"
        },
        "jornadas": {
          "type": "boolean"
        }
      },
      "default": {}
    }
  },
  "required": [
    "role"
  ]
}