{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_photo": {
      "type": "string",
      "format": "uri"
    },
    "text": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "document"
      ],
      "default": "image"
    },
    "audio_duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o do \u00e1udio em segundos (opcional)"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Denormalizado da conversa para RLS de leitura"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs de usu\u00e1rios que leram a mensagem"
    },
    "reply_to_id": {
      "type": "string",
      "description": "ID da mensagem \u00e0 qual esta responde"
    },
    "reply_to_text": {
      "type": "string",
      "description": "Trecho do texto da mensagem original citada"
    },
    "reply_to_sender_name": {
      "type": "string",
      "description": "Nome do autor da mensagem citada"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a mensagem foi editada"
    },
    "edited_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima edi\u00e7\u00e3o"
    }
  },
  "required": [
    "conversation_id",
    "participants"
  ],
  "rls": {
    "read": {
      "data.participants": "{{user.id}}"
    },
    "create": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}