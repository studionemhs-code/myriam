{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_photo": {
      "type": "string",
      "format": "uri"
    },
    "text": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "document"
      ],
      "default": "image"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Denormalizado da conversa para RLS de leitura"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs de usu\u00e1rios que leram a mensagem"
    }
  },
  "required": [
    "conversation_id",
    "participants"
  ],
  "rls": {
    "read": {
      "data.participants": "{{user.id}}"
    },
    "create": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}