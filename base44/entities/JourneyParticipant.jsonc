{
  "name": "JourneyParticipant",
  "type": "object",
  "properties": {
    "journey_id": {
      "type": "string"
    },
    "joined_date": {
      "type": "string",
      "format": "date"
    },
    "progress": {
      "type": "integer",
      "default": 0
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [],
      "description": "\u00cdndices das etapas conclu\u00eddas"
    }
  },
  "required": [
    "journey_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}