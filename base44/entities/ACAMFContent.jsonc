{
  "name": "ACAMFContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "lesson_order": {
      "type": "integer",
      "default": 0
    },
    "author": {
      "type": "string"
    },
    "cover_url": {
      "type": "string",
      "format": "uri"
    },
    "content": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "texto",
        "pdf",
        "ebook",
        "audio",
        "video",
        "imagem"
      ],
      "default": "texto"
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "youtube_id": {
      "type": "string"
    },
    "use_alternative_player": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "level": {
      "type": "string",
      "enum": [
        "iniciante",
        "intermediario",
        "aprofundamento"
      ],
      "default": "iniciante"
    },
    "duration": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "publicado",
        "arquivado"
      ],
      "default": "rascunho"
    },
    "related_content_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "related_day_number": {
      "type": "integer"
    },
    "view_count": {
      "type": "integer",
      "default": 0
    },
    "background_playback_type": {
      "type": "string",
      "enum": [
        "gratuito",
        "pago"
      ],
      "default": "gratuito"
    },
    "background_playback_product_id": {
      "type": "string"
    },
    "offline_download_type": {
      "type": "string",
      "enum": [
        "gratuito",
        "pago"
      ],
      "default": "pago"
    },
    "offline_download_product_id": {
      "type": "string"
    },
    "access_type": {
      "type": "string",
      "default": "gratuito",
      "description": "Tipo de acesso ao conte\u00fado"
    },
    "product_id": {
      "type": "string",
      "description": "Produto necess\u00e1rio quando o acesso \u00e9 pago"
    }
  },
  "required": [
    "title",
    "content_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "publicado"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}