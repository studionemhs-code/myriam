{
  "name": "MyriamStory",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_photo": {
      "type": "string",
      "format": "uri"
    },
    "author_status": {
      "type": "string",
      "enum": [
        "interessado",
        "preparacao",
        "consagrado",
        "usuario_escolhe"
      ],
      "default": "interessado"
    },
    "media_url": {
      "type": "string",
      "format": "uri",
      "description": "URL da foto ou v\u00eddeo do story"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "text"
      ],
      "default": "image"
    },
    "text": {
      "type": "string",
      "description": "Texto do story"
    },
    "background_color": {
      "type": "string",
      "default": "marian"
    },
    "viewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "media_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}