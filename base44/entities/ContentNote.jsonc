{
  "name": "ContentNote",
  "type": "object",
  "properties": {
    "content_id": {
      "type": "string",
      "description": "ID do conte\u00fado ACAMF ao qual a anota\u00e7\u00e3o se refere"
    },
    "page_number": {
      "type": "integer",
      "description": "N\u00famero da p\u00e1gina do PDF (opcional, para anota\u00e7\u00f5es em PDFs)",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "description": "Texto da anota\u00e7\u00e3o pessoal"
    },
    "color": {
      "type": "string",
      "default": "gold",
      "description": "Cor da anota\u00e7\u00e3o (gold, blue, green, pink)"
    }
  },
  "required": [
    "content_id",
    "text"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}