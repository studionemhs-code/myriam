{
  "name": "PrayerPlaylistItem",
  "type": "object",
  "properties": {
    "playlist_id": {
      "type": "string",
      "description": "ID da playlist \u00e0 qual o item pertence"
    },
    "prayer_id": {
      "type": "string",
      "description": "ID da ora\u00e7\u00e3o adicionada \u00e0 playlist"
    },
    "prayer_title": {
      "type": "string",
      "description": "T\u00edtulo da ora\u00e7\u00e3o (denormalizado para exibi\u00e7\u00e3o)"
    },
    "prayer_audio_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do \u00e1udio da ora\u00e7\u00e3o (denormalizado)"
    },
    "prayer_cover_url": {
      "type": "string",
      "format": "uri",
      "description": "URL da capa da ora\u00e7\u00e3o (denormalizado)"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "playlist_id",
    "prayer_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}