{
  "name": "WhatsappOtpSettings",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Ativa ou desativa a verifica\u00e7\u00e3o por OTP via WhatsApp no cadastro"
    },
    "webhook_url": {
      "type": "string",
      "format": "uri",
      "description": "URL do webhook que receber\u00e1 o token para envio via WhatsApp (Zapier, Make, n8n, API pr\u00f3pria)"
    },
    "message_template": {
      "type": "string",
      "default": "Ol\u00e1! Seu c\u00f3digo de verifica\u00e7\u00e3o Theotokos \u00e9: {{token}}",
      "description": "Template da mensagem enviada ao WhatsApp. Placeholders: {{token}} (c\u00f3digo de 6 d\u00edgitos) e {{nome}} (nome do usu\u00e1rio, se dispon\u00edvel)"
    },
    "token_expiration_minutes": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "description": "Tempo de expira\u00e7\u00e3o do token em minutos"
    },
    "max_attempts": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "description": "N\u00famero m\u00e1ximo de tentativas de valida\u00e7\u00e3o do c\u00f3digo"
    },
    "max_resends": {
      "type": "integer",
      "default": 3,
      "minimum": 0,
      "description": "N\u00famero m\u00e1ximo de reenvios do token antes de bloquear"
    }
  },
  "required": [
    "message_template"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}