{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "template_snapshot": {
      "type": "object",
      "description": "C\u00f3pia do template no momento da emiss\u00e3o"
    },
    "certificate_type": {
      "type": "string",
      "enum": [
        "preparacao",
        "jornada",
        "renovacao"
      ]
    },
    "journey_id": {
      "type": "string"
    },
    "journey_title": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "agreement_accepted": {
      "type": "boolean"
    },
    "agreement_text": {
      "type": "string",
      "description": "Snapshot do texto que o usu\u00e1rio concordou"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "typed",
        "uploaded"
      ]
    },
    "signature_data": {
      "type": "string",
      "description": "Nome digitado ou URL da imagem da assinatura"
    },
    "personal_data": {
      "type": "object",
      "description": "Dados preenchidos pelo usu\u00e1rio (cidade, estado, etc.)"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "template_id",
    "certificate_type",
    "issue_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}