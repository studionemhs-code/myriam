{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "description": "Identificador \u00fanico da funcionalidade"
    },
    "label": {
      "type": "string",
      "description": "Nome amig\u00e1vel exibido no painel administrativo"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Se a funcionalidade aparece no app para os usu\u00e1rios"
    },
    "access_type": {
      "type": "string",
      "default": "gratuito",
      "description": "Tipo de acesso \u00e0 funcionalidade"
    },
    "product_id": {
      "type": "string",
      "description": "Produto necess\u00e1rio quando o acesso \u00e9 pago"
    }
  },
  "required": [
    "feature",
    "label",
    "visible"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}