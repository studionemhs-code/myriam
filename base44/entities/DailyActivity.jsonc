{
  "name": "DailyActivity",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "format": "date",
      "description": "Dia (AAAA-MM-DD) em que o usu\u00e1rio abriu o app. Um registro por usu\u00e1rio por dia."
    }
  },
  "required": [
    "day"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}