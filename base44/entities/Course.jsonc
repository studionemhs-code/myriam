{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string",
      "format": "uri",
      "description": "Imagem wide para hero banner (16:9)"
    },
    "poster_url": {
      "type": "string",
      "format": "uri",
      "description": "Imagem vertical para card (2:3)"
    },
    "trailer_youtube_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "iniciante",
        "intermediario",
        "aprofundamento"
      ],
      "default": "iniciante"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "publicado",
        "arquivado"
      ],
      "default": "rascunho"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "accent_color": {
      "type": "string",
      "default": "#663399"
    },
    "access_type": {
      "type": "string",
      "default": "gratuito",
      "description": "Tipo de acesso ao curso"
    },
    "product_id": {
      "type": "string",
      "description": "Produto necess\u00e1rio quando o acesso \u00e9 pago"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "publicado"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}