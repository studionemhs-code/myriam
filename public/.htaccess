# SPA + suporte a Digital Asset Links (TWA/APK)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Digital Asset Links: serve a copia visivel /assetlinks.json na URL exigida pelo Android
  RewriteRule ^\.well-known/assetlinks\.json$ /assetlinks.json [L]

  # Nunca reescrever o resto da pasta .well-known
  RewriteRule ^\.well-known/ - [L]

  # Arquivos e diretorios existentes sao servidos direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html (rotas do React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# assetlinks.json precisa ser servido como JSON
<Files "assetlinks.json">
  ForceType application/json
</Files>

# Nao cachear o shell do app nem o service worker
<IfModule mod_headers.c>
  <FilesMatch "(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
