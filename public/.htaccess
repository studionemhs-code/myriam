# SPA + suporte a Digital Asset Links (TWA/APK)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nunca reescrever a pasta .well-known (assetlinks.json do TWA)
  RewriteRule ^\.well-known/ - [L]

  # Arquivos e diretórios existentes são servidos direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html (rotas do React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# assetlinks.json precisa ser servido como JSON
<Files "assetlinks.json">
  ForceType application/json
</Files>

# Não cachear o shell do app nem o service worker
<IfModule mod_headers.c>
  <FilesMatch "(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
